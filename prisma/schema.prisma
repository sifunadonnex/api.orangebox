// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Company {
  id                String      @id @default(cuid())
  name              String      @unique
  email             String      @unique
  phone             String?
  address           String?
  country           String?
  logo              String?
  status            String      @default("active") // active, suspended, expired
  subscriptionId    String?
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  users             User[]
  aircraft          Aircraft[]
  eventDefinitions  EventDefinition[]
  eventAssignments  EventDefinitionAssignment[]
}

model Subscription {
  id                    String      @id @default(cuid())
  planName              String      // Basic, Standard, Premium, Enterprise
  planType              String      // monthly, yearly
  maxUsers              Int         @default(5)
  maxAircraft           Int         @default(2)
  maxFlightsPerMonth    Int         @default(100)
  maxStorageGB          Int         @default(10)
  price                 Float
  currency              String      @default("USD")
  startDate             DateTime
  endDate               DateTime
  isActive              Boolean     @default(true)
  autoRenew             Boolean     @default(false)
  lastPaymentDate       DateTime?
  nextPaymentDate       DateTime?
  alertSentAt           DateTime?   // Track when suspension alert was sent
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  companies             Company[]
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  role            String        @default("user") // admin, fda, gatekeeper, user
  fullName        String?
  designation     String?
  department      String?
  username        String?
  password        String?
  image           String?
  phone           String?
  isActive        Boolean       @default(true)
  companyId       String?
  company         Company?      @relation(fields: [companyId], references: [id])
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notifications   Notification[]
  sessions        Session[]     // User's active sessions for single-device login
  createdEventDefinitions EventDefinition[]        @relation("EventDefinitionCreatedBy")
  createdEventVersions    EventDefinitionVersion[] @relation("EventVersionCreatedBy")
  approvedEventVersions   EventDefinitionVersion[] @relation("EventVersionApprovedBy")
}

// Session model for single-device login enforcement
model Session {
  id              String        @id @default(cuid())
  userId          String
  token           String        @unique
  deviceInfo      String?       // User-Agent info
  ipAddress       String?       // Client IP address
  isActive        Boolean       @default(true)
  expiresAt       DateTime
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Csv {
  id        String      @id @default(cuid())
  name      String
  file      String
  status    String?
  departure String?
  pilot     String?
  destination String?
  flightHours String?
  aircraftId String     // Corrected field name
  sampleIntervalMs Int?
  analysisSummary String?
  aircraft  Aircraft @relation(fields: [aircraftId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Exceedance Exceedance[]
  detectionRuns DetectionRun[]
}

model Aircraft {
  id           String          @id @default(cuid())
  airline      String
  aircraftMake String
  modelNumber  String?
  serialNumber String
  registration String?
  companyId    String
  parameters   String?
  company      Company      @relation(fields: [companyId], references: [id])
  csv          Csv[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  Flight       Flight[]
  primaryEventVersions EventDefinitionVersion[]
  eventAssignments     EventDefinitionAssignment[]
  Exceedance   Exceedance[]
  detectionRuns DetectionRun[]
}

model Flight {
  id         String      @id @default(cuid())
  name       String
  aircraftId String
  aircraft   Aircraft @relation(fields: [aircraftId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model EventDefinition {
  id              String      @id @default(cuid())
  companyId       String?
  eventCode       String
  eventType       String
  lifecycleStatus String      @default("active")
  createdBy       String
  company         Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdByUser   User        @relation("EventDefinitionCreatedBy", fields: [createdBy], references: [id])
  versions        EventDefinitionVersion[]
  detectionEvaluations DetectionRunDefinition[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([companyId, eventCode])
  @@index([companyId])
  @@index([lifecycleStatus])
}

model EventDefinitionVersion {
  id                String      @id @default(cuid())
  definitionId      String
  version           Int
  status            String      @default("draft")
  schemaVersion     Int         @default(1)
  eventName         String
  displayName       String
  eventDescription  String
  sop               String
  ruleJson          String
  ruleHash          String
  changeSummary     String
  eventParameter    String
  eventTrigger      String
  flightPhase       String
  triggerType       String      @default("structured")
  detectionPeriod   String      @default("All Flight")
  severities        String
  primaryAircraftId String?
  createdBy         String
  approvedBy        String?
  validatedAt       DateTime?
  publishedAt       DateTime?
  effectiveFrom     DateTime?
  effectiveTo       DateTime?
  definition        EventDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  primaryAircraft   Aircraft?       @relation(fields: [primaryAircraftId], references: [id], onDelete: SetNull)
  createdByUser     User            @relation("EventVersionCreatedBy", fields: [createdBy], references: [id])
  approvedByUser    User?           @relation("EventVersionApprovedBy", fields: [approvedBy], references: [id])
  assignments       EventDefinitionAssignment[]
  exceedances       Exceedance[]
  detectionEvaluations DetectionRunDefinition[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([definitionId, version])
  @@index([definitionId])
  @@index([status])
  @@index([ruleHash])
}

model EventDefinitionAssignment {
  id                  String   @id @default(cuid())
  definitionVersionId String
  scopeType           String
  companyId           String?
  aircraftId          String?
  aircraftMake        String?
  modelNumber         String?
  definitionVersion   EventDefinitionVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Cascade)
  company             Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  aircraft            Aircraft? @relation(fields: [aircraftId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())

  @@index([definitionVersionId])
  @@index([companyId])
  @@index([aircraftId])
  @@index([aircraftMake, modelNumber])
}

model Exceedance {
  id              String      @id @default(cuid())
  exceedanceValues String
  flightPhase     String
  parameterName   String
  description     String
  eventStatus     String 
  aircraftId      String
  flightId        String
  file            String?
  eventId         String?
  comment	  String?
  exceedanceLevel String?
  detectionRunId  String?
  startTimeMs     Int?
  endTimeMs       Int?
  durationMs      Int?
  peakValue       Float?
  ruleHash        String?
  isCurrent       Boolean     @default(true)
  supersededAt    DateTime?
  eventDefinitionVersion EventDefinitionVersion? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  aircraft        Aircraft @relation(fields: [aircraftId], references: [id])
  csv             Csv @relation(fields: [flightId], references: [id])
  notifications   Notification[]
  detectionRun    DetectionRun? @relation(fields: [detectionRunId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([detectionRunId])
  @@index([eventId, flightId])
  @@index([flightId, isCurrent])
}

model DetectionRun {
  id                  String   @id @default(cuid())
  flightId            String
  aircraftId          String
  engineVersion       String
  status              String
  inputHash           String
  ruleSetHash         String
  triggerType         String   @default("upload")
  triggeredBy         String?
  timingSource        String?
  sampleIntervalMs    Int?
  rowCount            Int      @default(0)
  applicableRuleCount Int      @default(0)
  evaluatedRuleCount  Int      @default(0)
  occurrenceCount     Int      @default(0)
  diagnosticsJson     String
  errorMessage        String?
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  flight              Csv      @relation(fields: [flightId], references: [id], onDelete: Cascade)
  aircraft            Aircraft @relation(fields: [aircraftId], references: [id], onDelete: Restrict)
  exceedances         Exceedance[]
  definitions         DetectionRunDefinition[]

  @@index([flightId])
  @@index([aircraftId])
  @@index([status])
  @@index([flightId, engineVersion, inputHash, sampleIntervalMs, ruleSetHash, status])
}

model DetectionRunDefinition {
  detectionRunId     String
  definitionId       String
  definitionVersionId String
  ruleHash           String
  status             String
  occurrenceCount    Int      @default(0)
  diagnosticsJson    String
  isCurrent          Boolean  @default(true)
  createdAt          DateTime @default(now())
  supersededAt       DateTime?
  detectionRun       DetectionRun @relation(fields: [detectionRunId], references: [id], onDelete: Cascade)
  definition         EventDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  definitionVersion  EventDefinitionVersion @relation(fields: [definitionVersionId], references: [id], onDelete: Cascade)

  @@id([detectionRunId, definitionVersionId])
  @@index([definitionId, isCurrent])
  @@index([definitionVersionId])
}

model Notification {
  id              String      @id @default(cuid())
  userId          String      // User to notify
  exceedanceId    String      // Reference to the exceedance
  message         String
  level           String      // Level 1, 2, or 3
  isRead          Boolean     @default(false)
  user            User        @relation(fields: [userId], references: [id])
  exceedance      Exceedance  @relation(fields: [exceedanceId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
